# ============================================================
#  AcademiQ — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ============================================================

# --- Shared secrets -----------------------------------------
JWT_SECRET=changeme_use_a_long_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Database (PostgreSQL) ----------------------------------
POSTGRES_USER=academiq
POSTGRES_PASSWORD=academiq_pass
POSTGRES_DB=academiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MongoDB (document metadata) ----------------------------
MONGO_URI=mongodb://mongodb:27017/academiq_docs

# --- Redis (Celery broker) ----------------------------------
REDIS_URL=redis://redis:6379/0

# --- Qdrant (vector DB) -------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=academiq_docs

# --- Twilio (parent contact) --------------------------------
# Set TWILIO_ENABLED=true and fill in credentials for real calls/SMS.
# Leave TWILIO_ENABLED=false to use mock mode (logs only).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# Twilio Proxy Service SID for masked/proxy calls:
TWILIO_PROXY_SERVICE_SID=KSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM Backend (nlp-rag-service) --------------------------
# Options: "ollama" | "openai" | "groq"
# "groq" is recommended for laptops (free tier: console.groq.com)
LLM_BACKEND=groq
LLM_MODEL=llama-3.1-8b-instant

# For groq or openai-compatible:
OPENAI_API_KEY=your_groq_or_openai_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# For local Ollama (uncomment ollama service in docker-compose.yml first):
# LLM_BACKEND=ollama
# OLLAMA_HOST=http://ollama:11434

# --- Service internal URLs (used by api-gateway) ------------
AUTH_SERVICE_URL=http://auth-service:8001
ACADEMIC_DATA_SERVICE_URL=http://academic-data-service:8002
PARENT_CONTACT_SERVICE_URL=http://parent-contact-service:8003
DOCUMENT_SERVICE_URL=http://document-service:8004
NLP_RAG_SERVICE_URL=http://nlp-rag-service:8005
PREDICTION_SERVICE_URL=http://prediction-service:8006
REPORT_SERVICE_URL=http://report-service:8007
REPORTS_DIR=/app/reports

# --- Misc ---------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO
